{
  "version": 6,
  "configurePresets": [
    {
      "name": "local-app-release",
      "displayName": "Local App Release",
      "inherits": "app-release-base",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/path/to/Qt/6.5.3/gcc_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "local-app-release",
      "configurePreset": "local-app-release"
    }
  ]
}
